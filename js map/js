document.addEventListener("DOMContentLoaded", function () {
  var mapElement = document.getElementById("map");
 
  // Checks if the map element exists and if Leaflet is loaded
  if (!mapElement || typeof L === "undefined") {
    return;
  }
 
  // Location coordinates and place name
  var location = [-26.10833, 28.05417];
  var placeName = "Shop LL63, Sandton City Mall, 83 Rivonia Road, Sandton, Johannesburg, 2196";
 
  
  var map = L.map("map", {
    scrollWheelZoom: false // stops the page from getting "stuck" when scrolling
  }).setView(location, 16);
 
  //layer of the map
  L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
    subdomains: "abcd",
    maxZoom: 19,
    attribution: "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors &copy; <a href=\"https://carto.com/attributions\">CARTO</a>"
  }).addTo(map);
 
  // Added a marker with a popup
  L.marker(location)
    .addTo(map)
    .bindPopup("<strong>Golden Aura Cosmetics</strong><br>" + placeName)
    .openPopup();
 
  // Allows scroll-zoom only after the user clicks the map
  map.on("click", function () {
    map.scrollWheelZoom.enable();
  });
  map.on("mouseout", function () {
    map.scrollWheelZoom.disable();
  });
});
 
 