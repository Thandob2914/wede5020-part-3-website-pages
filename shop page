:root {
  --sage: #9caf88;
  --sage-dark: #6f8560;
  --cream: #f5efe0;
  --gold: #c9a24b;
  --gold-dark: #a8832f;
  --text: #2f3a2c;
  --white: #ffffff;
  --font-main: "Segoe UI", Arial, sans-serif;
  --radius: 0.75rem;
  --shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.12);
}
 
/* ---------- 2. Base / Reset ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
 
html {
  font-size: 100%;
  scroll-behavior: smooth;
}
 
body {
  font-family: var(--font-main);
  color: var(--text);
  background-color: var(--cream);
  line-height: 1.6;
}
 
img {
  max-width: 100%;
  height: auto;
  display: block;
}
 
a {
  color: inherit;
}
 
h1, h2, h3 {
  line-height: 1.25;
}
 
h2 {
  font-size: 1.75rem;
  margin-bottom: 1rem;
  color: var(--sage-dark);
}
 
h3 {
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
}
 
p {
  margin-bottom: 1rem;
}
 
main section {
  padding: 3rem 5%;
  max-width: 75rem;
  margin: 0 auto;
}
 
/* ---------- 3. Header & Navigation (Flexbox) ---------- */
header {
  background-color: var(--sage);
  color: var(--white);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  padding: 1rem 5%;
  box-shadow: var(--shadow);
  position: sticky;
  top: 0;
  z-index: 100;
}
 
.logo h1 {
  font-size: 1.6rem;
  color: var(--white);
  letter-spacing: 0.05rem;
}
 
nav ul {
  list-style: none;
  display: flex;
  gap: 1.5rem;
}
 
nav a {
  text-decoration: none;
  color: var(--white);
  font-weight: 600;
  padding: 0.4rem 0.2rem;
  border-bottom: 0.15rem solid transparent;
  transition: border-color 0.3s, color 0.3s;
}
 
nav a:hover,
nav a:focus {
  color: var(--cream);
  border-bottom-color: var(--gold);
}
 
nav a:active {
  color: var(--gold);
}
 
/* ---------- 4. Hero ---------- */
.hero {
  max-width: 100%;
  text-align: center;
  padding: 5rem 5%;
  background: linear-gradient(135deg, var(--sage), var(--cream));
}
 
.hero h2 {
  font-size: 2.5rem;
  color: var(--text);
}
 
.hero p {
  max-width: 40rem;
  margin: 0 auto 1.5rem;
  font-size: 1.1rem;
}
 
.cta-button {
  display: inline-block;
  background-color: var(--gold);
  color: var(--white);
  text-decoration: none;
  font-weight: 700;
  padding: 0.8rem 2rem;
  border-radius: 2rem;
  box-shadow: var(--shadow);
  transition: background-color 0.3s, transform 0.3s;
}
 
.cta-button:hover,
.cta-button:focus {
  background-color: var(--gold-dark);
  transform: translateY(-0.15rem);
}
 
.cta-button:active {
  transform: translateY(0);
}
 
/* ---------- 5. Intro ---------- */
.intro {
  text-align: center;
}
 
.intro p {
  max-width: 50rem;
  margin-left: auto;
  margin-right: auto;
}
 
/* ---------- 6. Card grids (CSS Grid) ---------- */
.value-cards,
.range-cards {
  display: grid;
  gap: 1.5rem;
}
 
.value-cards {
  grid-template-columns: repeat(3, 1fr);
}
 
.range-cards {
  grid-template-columns: repeat(3, 1fr);
}
 
.value-card,
.range-card {
  background-color: var(--white);
  padding: 1.5rem;
  border-radius: var(--radius);
  border-top: 0.3rem solid var(--gold);
  box-shadow: var(--shadow);
  transition: transform 0.3s, box-shadow 0.3s;
}
 
.value-card:hover,
.range-card:hover {
  transform: translateY(-0.3rem);
  box-shadow: 0 0.5rem 1.2rem rgba(0, 0, 0, 0.18);
}
 
.value-card h3,
.range-card h3 {
  color: var(--sage-dark);
}
 
/* ---------- 7. Testimonials ---------- */
.testimonials-preview {
  text-align: center;
}
 
blockquote {
  background-color: var(--white);
  border-left: 0.3rem solid var(--gold);
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
  margin: 0 auto 1rem;
  max-width: 45rem;
  font-style: italic;
  box-shadow: var(--shadow);
}
 
/* ---------- 8. Gift sets & How it works ---------- */
.gift-sets ul,
.how-it-works ol {
  margin-left: 1.5rem;
}
 
.gift-sets li,
.how-it-works li {
  margin-bottom: 0.6rem;
}
 
.gift-sets li::marker,
.how-it-works li::marker {
  color: var(--gold);
}
 
/* ---------- 9. FAQ ---------- */
.faq-item {
  background-color: var(--white);
  padding: 1.25rem 1.5rem;
  border-radius: var(--radius);
  margin-bottom: 1rem;
  box-shadow: var(--shadow);
}
 
.faq-item h3 {
  color: var(--sage-dark);
}
 
.faq-item p {
  margin-bottom: 0;
}
 
/* ---------- 10. Newsletter form ---------- */
.newsletter {
  text-align: center;
  background-color: var(--sage);
  color: var(--white);
  max-width: 100% !important;
  border-radius: 0;
}
 
.newsletter h2 {
  color: var(--white);
}
 
.newsletter form {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.75rem;
  margin-top: 1rem;
}
 
.newsletter label {
  font-weight: 600;
}
 
.newsletter input[type="email"] {
  padding: 0.7rem 1rem;
  border: 0.15rem solid transparent;
  border-radius: 2rem;
  min-width: 16rem;
  font-size: 1rem;
}
 
.newsletter input[type="email"]:focus {
  outline: none;
  border-color: var(--gold);
}
 
.newsletter button {
  background-color: var(--gold);
  color: var(--white);
  border: none;
  padding: 0.75rem 1.75rem;
  border-radius: 2rem;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: background-color 0.3s;
}
 
.newsletter button:hover,
.newsletter button:focus {
  background-color: var(--gold-dark);
}
 
/* ---------- 11. Footer ---------- */
footer {
  background-color: var(--text);
  color: var(--cream);
  padding: 1.5rem 5%;
}
 
.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}
 
.footer-content p {
  margin-bottom: 0;
}
 
.social-links {
  display: flex;
  gap: 1.25rem;
}
 
.social-links a {
  text-decoration: none;
  color: var(--cream);
  transition: color 0.3s;
}
 
.social-links a:hover,
.social-links a:focus {
  color: var(--gold);
}
 
/* =========================================
   RESPONSIVE DESIGN (media queries)
   ========================================= */
 
/* ---------- Tablet: 768px and below ---------- */
@media (max-width: 768px) {
  header {
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }
 
  nav ul {
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
 
  .hero h2 {
    font-size: 2rem;
  }
 
  .value-cards,
  .range-cards {
    grid-template-columns: repeat(2, 1fr);
  }
 
  .footer-content {
    flex-direction: column;
    text-align: center;
  }
}
 
/* ---------- Mobile: 480px and below ---------- */
@media (max-width: 480px) {
  h2 {
    font-size: 1.4rem;
  }
 
  .logo h1 {
    font-size: 1.3rem;
  }
 
  nav ul {
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
 
  main section {
    padding: 2rem 5%;
  }
 
  .hero {
    padding: 3rem 5%;
  }
 
  .hero h2 {
    font-size: 1.7rem;
  }
 
  .value-cards,
  .range-cards {
    grid-template-columns: 1fr;
  }
 
  .newsletter form {
    flex-direction: column;
  }
 
  .newsletter input[type="email"],
  .newsletter button {
    width: 100%;
  }
}
 